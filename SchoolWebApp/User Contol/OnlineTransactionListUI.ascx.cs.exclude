    #region "Private Method"

    /// <summary>
    /// This method used to hide error labels.
    /// </summary>
    private void DisableErrorLabel()
    {
        trTotalRec.Visible = false;
        lblError.Visible = false;
    }
   
    public override List<Control> AddControls()
    {
        List<Control> olstControls = new List<Control>();
        olstControls.Add(btnShow);
        olstControls.Add(btnSave);
        olstControls.Add(btnBack);
        olstControls.Add(btnExport);
        olstControls.Add(optTransactionNumber);
        olstControls.Add(ClearanceListFilters.RegNoRadioButton);
        olstControls.Add(ClearanceListFilters.PaymentDateRadioButton);
        olstControls.Add(ClearanceListFilters.ClearanceDateRadioButton);
        return olstControls;
    }

    /// <summary>
    /// This method initialises variables.
    /// </summary>
    private void InitiliseControl()
    {
        txtTransactionIDNumber.Focus();
        optTransactionNumber.Checked = true;
        optTransactionNumber_CheckedChanged(null, null);
        ClearanceListFilters.DisableAll();
        valSumErrorMsg.HeaderText = Constants.S_VALIDATION_SUMMARY_HEADER;
        valSave.HeaderText = Constants.S_VALIDATION_SUMMARY_HEADER;
        grdOnlineFeeTransactionDetails.PageSize = GRID_PAGE_COUNT;
        hidPageNo.Value = HIDE_PAGE_NUMBER;        
    }

    /// <summary>
    /// This method used to fill the grid according to selected filter.
    /// </summary>
    public override void FillPaymnetsGrid()
    {
        lblError.Visible = false;
        DataSet odsOnlineTransaction = null;
        DataTable odtOnlineTrasaction = null;
        int iTotalAmount = 0;
        int iAcaYearId = Convert.ToInt32(Session[Constants.S_SESSION_CURRENT_ACADEMIC_YEAR_ID]);
        if (optTransactionNumber.Checked)
        {
            odsOnlineTransaction = NetBankingPaymentTransactionsBL.FetchOnlineTransactionDetail(txtTransactionIDNumber.Text.Trim(), "", "", ClearanceListFilters.IncludeAll, FILTER_BY_TRANSACTION_ID, iAcaYearId);
            odtOnlineTrasaction = odsOnlineTransaction.Tables[0];
        }
        else if (ClearanceListFilters.RegNoChecked)
        {
            odsOnlineTransaction = NetBankingPaymentTransactionsBL.FetchOnlineTransactionDetail(ClearanceListFilters.StudentNameOrRegNo.Trim(), "", "", ClearanceListFilters.IncludeAll, FILTER_BY_STUDENT_NAME_REG_NO, iAcaYearId);
            odtOnlineTrasaction = odsOnlineTransaction.Tables[0];
        }
        else if (ClearanceListFilters.PaymentDateChecked)
        {
            odsOnlineTransaction = NetBankingPaymentTransactionsBL.FetchOnlineTransactionDetail(null, ClearanceListFilters.PaymentStartDate.ToString(), ClearanceListFilters.PaymentEndDate.ToString(), ClearanceListFilters.IncludeAll, FILTER_BY_TRANSACTION_DATE, iAcaYearId);
            odtOnlineTrasaction = odsOnlineTransaction.Tables[0];
        }
        else if (ClearanceListFilters.ClearanceDateChecked)
        {
            odsOnlineTransaction = NetBankingPaymentTransactionsBL.FetchOnlineTransactionDetail(null, ClearanceListFilters.ClearanceStartDate.ToString(), ClearanceListFilters.ClearanceEndDate.ToString(), ClearanceListFilters.IncludeAll, FILTER_BY_CLEARANCE_DATE, iAcaYearId);
            odtOnlineTrasaction = odsOnlineTransaction.Tables[0];
        }
        if (odsOnlineTransaction != null)
        {
            if (odtOnlineTrasaction != null)
            {
                grdOnlineFeeTransactionDetails.Visible = true;
                SetGridViewDateColumnProperties();
                grdOnlineFeeTransactionDetails.DataSource = odtOnlineTrasaction.DefaultView;
                grdOnlineFeeTransactionDetails.DataBind();
                hidRowCnt.Value = Convert.ToString(grdOnlineFeeTransactionDetails.Rows.Count);
            }
            if (Convert.ToString(odsOnlineTransaction.Tables[1].Rows[0][0]) != string.Empty)
            {
                tblTotalAmount.Visible = true;
                iTotalAmount = Convert.ToInt32(odsOnlineTransaction.Tables[1].Rows[0][0]);
                lblTotalAmount.Text = iTotalAmount.ToString();
            }
            else
                tblTotalAmount.Visible = false;

            if (odtOnlineTrasaction.Rows.Count == 0)
                trTotalRec.Visible = false;
        }

    }

    /// <summary>
    /// This method is used to display transaction date in proper formate.
    /// </summary>
    private void SetGridViewDateColumnProperties()
    {
        const Int32 I_COLUMN_INDEX_PAYMENT_DATE = 6;
        BoundField oPaymentDate = (BoundField)grdOnlineFeeTransactionDetails.Columns[I_COLUMN_INDEX_PAYMENT_DATE];
        oPaymentDate.HtmlEncode = false;
        oPaymentDate.DataFormatString = Constants.S_STANDARD_GRID_DATE_FORMAT;
    }       

    /// <summary>
    ///  This XML is used to set the parameters to clear online transactions detais.
    /// </summary>    
    private string GenerateXML()
    {
        const string S_ELEMENT = "element";
        string sAttribute;
        XmlDocument oDoc = new XmlDocument();
        XmlElement oElement = oDoc.CreateElement("OnlineTrasactionInfo");
        XmlNode oXmlRootNode = oDoc.CreateNode(S_ELEMENT, "OnlineTrasactionInfo", "");
        for (int i = 0; i < grdOnlineFeeTransactionDetails.Rows.Count; i++)
        {
            TextBox otxtClearanceDate = (TextBox)grdOnlineFeeTransactionDetails.Rows[i].Cells[I_COLUMN_INDEX_CLEARANCE_DATETIME].FindControl("txtclearance");
            TextBox otxtTSPLTransactionID = (TextBox)grdOnlineFeeTransactionDetails.Rows[i].Cells[I_COLUMN_INDEX_TSPLTRANSACTIONID].FindControl("txtTSPLTransactionID");

            XmlNode oXMLNode = oDoc.CreateNode(S_ELEMENT, "OnlineTrasactionInfo", "");

            sAttribute = "NetBankingPaymentTransactionID";
            XmlAttribute oAttr = oDoc.CreateAttribute(sAttribute);
            oAttr.Value = grdOnlineFeeTransactionDetails.DataKeys[i]["NetBankingPaymentTransactionID"].ToString();
            oXMLNode.Attributes.Append(oAttr);

            sAttribute = "TPSLTransactionID";
            oAttr = oDoc.CreateAttribute(sAttribute);
            oAttr.Value = otxtTSPLTransactionID.Text.Trim();
            oXMLNode.Attributes.Append(oAttr);

            sAttribute = "Update_Date";
            oAttr = oDoc.CreateAttribute(sAttribute);
            oAttr.Value = System.DateTime.Now.ToString();
            oXMLNode.Attributes.Append(oAttr);

            sAttribute = "Updated_By_Id";
            oAttr = oDoc.CreateAttribute(sAttribute);
            oAttr.Value = Session[Constants.S_SESSION_USER_ID].ToString();
            oXMLNode.Attributes.Append(oAttr);

            sAttribute = "ClearanceDate";
            oAttr = oDoc.CreateAttribute(sAttribute);
            if (otxtClearanceDate.Text.Trim() != "")
                oAttr.Value = otxtClearanceDate.Text.Trim();
            else
                oAttr.Value = DBNull.Value.ToString();
            oXMLNode.Attributes.Append(oAttr);

            oXmlRootNode.AppendChild(oXMLNode);
        }
        oElement.AppendChild(oXmlRootNode);
        return oElement.InnerXml;
    }

    #endregion

    #region "Public"

    /// <summary>
    /// This method exposes the functionality to check the Radio button of transaction number.
    /// </summary>
    public void SetTransactionNumberRadioButtons()
    {
        txtTransactionIDNumber.Enabled = true;
        DisableErrorLabel();
        ClearanceListFilters.RegNoRadioButton.Checked = !optTransactionNumber.Checked;
        ClearanceListFilters.PaymentDateRadioButton.Checked = !optTransactionNumber.Checked;
        ClearanceListFilters.ClearanceDateRadioButton.Checked = !optTransactionNumber.Checked;
        ClearanceListFilters.DisableAll();
    }

    /// <summary>
    /// This method exposes the functionality of showing the grid depending on the caption of the show button.
    /// </summary>
    public override void ShowPaymnetsGrid()
    {
        if (btnShow.Text == "Show")
        {
            hidPageNo.Value = HIDE_PAGE_NUMBER;
            grdOnlineFeeTransactionDetails.PageIndex = Constants.I_ZERO;
            FillPaymnetsGrid();
            btnShow.Text = "Change Input";
            optTransactionNumber.Enabled = false;
            txtTransactionIDNumber.Enabled = false;           
            this.ClearanceListFilters.EnableDisableControlChecked(false);
            this.ClearanceListFilters.EnableDisableControls(false);
        }
        else
        {
            btnShow.Text = "Show";
            optTransactionNumber.Enabled = true;
            txtTransactionIDNumber.Enabled = true;
            this.ClearanceListFilters.EnableDisableControlChecked(true);
            this.ClearanceListFilters.EnableDisableControls(true);
            grdOnlineFeeTransactionDetails.DataSource = null;
            grdOnlineFeeTransactionDetails.DataBind();
            grdOnlineFeeTransactionDetails.Visible = false;
            trTotalRec.Visible = false;
            tblTotalAmount.Visible = false;
        }
        lblError.Visible = false;
    }
   
    #endregion 

    #region Functionality For Export

    /// <summary>
    /// This event is used to export the cheque clearance details in the Excel sheet.
    /// </summary>
    /// <param name="sender"></param>
    /// <param name="e"></param>
    protected void btnExport_Click(object sender, EventArgs e)
    {
        try
        {
            ReportDisplay oReportDisplay = new ReportDisplay(Constants.ExportReports.OnlineTransactionClearanceDetails, GetFilterString());
            oReportDisplay.DisplayReport();
        }
        catch (ThreadAbortException)
        {

        }
        catch (Exception ex)
        {
            BusinessLogic.Exceptions.ExceptionHandler.WriteExceptionToErrorLog
            (ex.Message + Constants.S_TRACE + ex.StackTrace,
            System.Reflection.MethodBase.GetCurrentMethod().DeclaringType.FullName + '.' + System.Reflection.MethodBase.GetCurrentMethod().Name,
            Convert.ToInt32(Session[Constants.S_SESSION_USER_ID]));
        }
    }


    private string GetFilterString()
    {
        string sFilter = "";
        string sViewFilter = Constants.S_EXPORT_ONLINETRANSACTIONCLEARANCE_USP + "..Filter}";
        string sExportFilter = "";
        int iAcaYearId = Convert.ToInt32(Session[Constants.S_SESSION_CURRENT_ACADEMIC_YEAR_ID]);
        if (optTransactionNumber.Checked)
            sFilter = SetFilterString(txtTransactionIDNumber.Text.Trim(), "", "", ClearanceListFilters.IncludeAll, FILTER_BY_TRANSACTION_ID, iAcaYearId);
        else if (ClearanceListFilters.RegNoChecked)
            sFilter = SetFilterString(ClearanceListFilters.StudentNameOrRegNo, "", "", ClearanceListFilters.IncludeAll, FILTER_BY_STUDENT_NAME_REG_NO, iAcaYearId);
        else if (ClearanceListFilters.PaymentDateChecked)
            sFilter = SetFilterString(null, ClearanceListFilters.PaymentStartDate.ToString(), ClearanceListFilters.PaymentEndDate.ToString(), ClearanceListFilters.IncludeAll, FILTER_BY_TRANSACTION_DATE, iAcaYearId);
        else if (ClearanceListFilters.ClearanceDateChecked)
            sFilter = SetFilterString(null, ClearanceListFilters.ClearanceStartDate.ToString(), ClearanceListFilters.ClearanceEndDate.ToString(), ClearanceListFilters.IncludeAll, FILTER_BY_CLEARANCE_DATE, iAcaYearId);
        sExportFilter = "(" + sViewFilter + "==" + sFilter + ")@ ";
        return sExportFilter;
        //return sFilter;
    }

    /// <summary>
    /// This method generates the report filter as per the field selection.
    /// </summary>
    /// <returns></returns>
    private string SetFilterString(string asFilter, string adStartDate, string adEndDate, bool abIncldeCheck, int aiOptCheck, int aiAcadmicID)
    {
        string sFilter = "";
        asFilter = asFilter != null ? asFilter : "";
        switch (aiOptCheck)
        {
            case 1:
                sFilter = " AND NetBankingPaymentTransactions.TPSLTransactionID like '%" + asFilter + "%'";
                break;
            case 2:
                sFilter = " AND ( SchoolWise_Student_Master.Enrolment_Number like '%" + StringUtility.ReplaceSingleQuoteInString(asFilter, false) + "%'" +
                    " OR SchoolWise_Student_Master.First_Name like '%" + StringUtility.ReplaceSingleQuoteInString(asFilter, false) + "%'" +
                    " OR SchoolWise_Student_Master.Middle_Name like '%" + StringUtility.ReplaceSingleQuoteInString(asFilter, false) + "%'" +
                    " OR  SchoolWise_Student_Master.Last_Name like '%" + StringUtility.ReplaceSingleQuoteInString(asFilter, false) + "%')";
                break;
            case 3:
                if (adStartDate != "" && adEndDate != "")
                    sFilter = " AND NetBankingPaymentTransactions.TransactionDateTime BETWEEN '" + adStartDate.ToString() + "' AND '" + adEndDate.ToString() + "'";
                if (adStartDate != "" && adEndDate == "")
                    sFilter = " AND NetBankingPaymentTransactions.TransactionDateTime >='" + adStartDate.ToString() + "'";
                if (adStartDate == "" && adEndDate != "")
                    sFilter = " AND NetBankingPaymentTransactions.TransactionDateTime <='" + adEndDate.ToString() + "'";
                break;
            case 4:
                if (adStartDate != "" && adEndDate != "")
                    sFilter = " AND NetBankingPaymentTransactions.ClearanceDate BETWEEN '" + adStartDate.ToString() + "' AND '" + adEndDate.ToString() + "'";
                if (adStartDate != "" && adEndDate == "")
                    sFilter = " AND NetBankingPaymentTransactions.ClearanceDate >='" + adStartDate.ToString() + "'";
                if (adStartDate == "" && adEndDate != "")
                    sFilter = " AND NetBankingPaymentTransactions.ClearanceDate <='" + adEndDate.ToString() + "'";
                break;
        }

        if (!abIncldeCheck)
            sFilter = sFilter + " AND NetBankingPaymentTransactions.ClearanceDate is null ";
        return sFilter = sFilter + "AND Schoolwise_Student_Fee_Details_1.Academic_Year_Id = " + aiAcadmicID;
    }

    #endregion
    
}
