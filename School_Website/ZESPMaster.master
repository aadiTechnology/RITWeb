    <style type="text/css">
        .style1
        {
            background-image: url('images/subpgTopImgSml.jpg');
            background-position: left bottom;
            background-repeat: no-repeat;
            background-color: #FFF;
            height: 100px;
            width: 80%;
            float: left;
        }
        
        .logo
        {
            background-image: url('images/165X100.png');
            background-position: right bottom;
            background-repeat: no-repeat;
            background-color: #FFF;
            height: 100px;
            width: 20%;
            float: right;
        }
    </style>
</head>
