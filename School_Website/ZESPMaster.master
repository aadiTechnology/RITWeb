    <script language="javascript" type="text/javascript">
        function openTerms() {
            window.open('TermsOfUse.aspx', '_new', 'scrollbars=no,resizable=no,menubar=no,status=no,titlebar=no,toolbar=no,top=100,left=50,width=900,height=780');
        }

        function blinkIt() {
            if (!document.all) return;
            else {
                for (i = 0; i < document.all.tags('blink').length; i++) {
                    s = document.all.tags('blink')[i];
                    s.style.visibility = (s.style.visibility == 'visible') ? 'hidden' : 'visible';
                }
            }
        }

        $(document).ready(function () {
            window.setInterval(blinkSchoolName, 500);
        });

        function blinkSchoolName() {
            $('#schoolname').toggle();
        }

    </script>
    <script type="text/javascript" src="RITeSchool/Scripts/jquery-1.7.min.js"></script>
    <script type="text/javascript" src="RITeSchool/Scripts/jquery-blink.js"></script>
    <script src="js/jquery.qtip-1.0.0-rc3.min.js" type="text/javascript"></script>    
