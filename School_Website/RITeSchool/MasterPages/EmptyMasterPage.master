<%@ Master Language="C#" AutoEventWireup="true" CodeFile="EmptyMasterPage.master.cs" Inherits="EmptyMasterPage" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml">
<head id="Head1" runat="server">
	<title>Welcome to  <%= ConfigurationManager.AppSettings["SchoolName"] %></title>
	<link href="../Styles/Styles.css" type="text/css" rel="stylesheet" />
	<link href="../Styles/Styles1.css" type="text/css" rel="stylesheet" />
	<link href="../Styles/Styles2.css" type="text/css" rel="stylesheet" />
    <link href="~/Styles/Styles2.css" type="text/css" rel="stylesheet" />
	<link href="../Styles/Styles3.css" type="text/css" rel="stylesheet" />
	<link href="../Styles/round-button.css" type="text/css" rel="stylesheet" />
	<link href="../Styles/Toppers.css" type="text/css" rel="stylesheet" />
	<link href="../Styles/ppsStyles.css" type="text/css" rel="stylesheet" />	
    <link rel="SHORTCUT ICON" href="../../images/favicon.ico?version=1.2" type="image/x-icon" />
	<script type="text/javascript" src="../Scripts/jquery-1.4.1-vsdoc.js"></script>
	<script src="../Scripts/jquery-1.7.min.js" type="text/javascript"></script>
	<script type="text/javascript" src="../Scripts/Ajax.js"></script>
	<script type="text/javascript" src="../Scripts/Validate2.js"></script>
	<script type="text/javascript" src="../Scripts/Validations.js"></script>
	<script type="text/javascript" src="../Scripts/Script.js?version=1.0"></script>

	<script type="text/javascript" src="../RITAutoCompleteService/RITAutoSuggest.js?version=1.4"></script>	
	<script src="../Scripts/jquery-ui.js" type="text/javascript"></script>
	<link href="../Styles/jquery-ui.css" rel="stylesheet" type="text/css" />		
	
	<style type="text/css">

		#disablepage
		{
			 top:0px;
			 left:0px;
			 width:100%;
			 height:100%;
			 z-index :1001;
			background-color: Gray;
			opacity:0.5;
			-moz-opacity:0.5;
			filter: alpha(opacity=50);
			position:absolute;
			background-image:url(../images/Loading9.gif);
			background-repeat:no-repeat;
			background-position:center;			

		 }
		 
		 	 .ui-menu .ui-menu-item a
	    {
		    font: 9pt arial;
	    }
		</style>

		<script type="text/javascript">

		    $(document).ready(function () {

		        $(document).on("click", "input:submit[disable-page='true']", function () {
		            DisablePage(this);
		        });
		    });

		    function DisablePage(btnObj) {
		        if (typeof (Page_IsValid) != "undefined") {
		            if (!Page_IsValid) {
		                return;
		            }
		        }
		        var height = $(document).height() + 50;
		        var width = $(document).width();
		        $(btnObj).after("<div id='disablepage' style='height:" + height + "px;width:" + width + "px;'/>");
		    }

		</script>
	<asp:ContentPlaceHolder ID="headContentPlaceholder" runat="server" />
    <!-- Script to Open the Theme Pop Up -->
    <script language="javascript" type="text/javascript">

        $("[id*=lnkThemes]").live("click", function () {
            $(".overlayInner").css("position", "fixed");
            $(".overlayOuter").height($(document).height());
            $(".overlayOuter").width($(document).width());
            $(".overlayInner").load("div#MainDiv",
            // the following is the callback   
                function () {
                    $(".overlayOuter").slideDown(300); $(".overlayInner").slideDown(300);
                    $("select[id*=ddlThemes]").focus();
                });
        });        

    </script>
</head>
<body  style="margin: 0; width: 100%; height: 90%; position: absolute; background-image: url(../images/BGline.gif);
    background-repeat: repeat;">
    <form id="form1" runat="server">
    <table style="width: 100%; height: 100%;" border="0" align="center" cellpadding="0"
					cellspacing="0">
					<tr>
						<td valign="top">
							<table style="width: 100%" cellpadding="0" cellspacing="0">
								<tr valign="top" width="80%" class="ClsLoadingBG">
									<td align="center" colspan="2" style="padding-top: 2px;">
									
                                               										
									</td>
								</tr>
							</table>
						</td>
					</tr>
					<tr id="trYearStatus" runat="server" visible="false">
						<td align="center">
							<marquee style="cursor: progress; border-top-width: thin; vertical-align: bottom;
								color: MediumVioletRed; border-top-color: blue;" scrollamount="1" scrolldelay="2"
								onmouseover="this.stop()" onmouseout="this.start()">                                                
                                <table>
                                    <tr>                    
                                        <td class="ClsBorderlight" style="background-color:#E6E6E6; background-repeat:repeat;border-width:medium;border-style:outset" align="center">                                        
                                            <asp:Label ID="lblYearStatus" runat="server"  
                                               Font-Bold="True" Font-Size="Medium" ForeColor="Red"></asp:Label>                                        
                                        </td>
                                    </tr>
                                </table></marquee>
						</td>
					</tr>
					<tr align="center" style="height: 98%" valign="top">
						<td valign="top" align="center">
							<asp:ContentPlaceHolder ID="MainBody" runat="server" />						
							
						</td>
					</tr>
				</table>
    </form>
</body>
</html>
