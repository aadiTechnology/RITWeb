    <script type="text/javascript">
        $(document).ready(function () {
            $(document).on("click", "input:submit[disable-page='true']", function () {
                DisablePage(this);
            });

            /// As new theme is included in master page, alignment is changed for close button of static pop up like school notice.
            /// added class to parent div                
            $("img[src*='close_vista.gif']").parent().parent().addClass('close-img-style');


            // Local storage key for user profile picture
            if (window.location.href.indexOf("ControlPanel.aspx") == -1) {
                var localStorageKeyOfUserPic = "UserProfilePic" + "_" + _userId;
                
                var profilePicDataOnMaster = loadDataFromLocalStorage(localStorageKeyOfUserPic);
                if (profilePicDataOnMaster != null && profilePicDataOnMaster.length != 0 && profilePicDataOnMaster[0].ProfilePicture != null && profilePicDataOnMaster[0].ProfilePicture != "") {
                    var userImage = "data:image/png;base64," + profilePicDataOnMaster[0].ProfilePicture;
                    $("[id*='imgProfilePic']").attr("src", userImage);
                }
            }
        });

        // This function is use to check local is undefined, expire and empty storage.
        function loadDataFromLocalStorage(key) {
            try {
                // If storage undefined return null
                if (typeof (Storage) == "undefined") { return null; }

                // Get data from local storage and check otherwise return null.
                var record = JSON.parse(localStorage.getItem(key));
                if (!record) { return null; }

                if (record.hasOwnProperty('timestamp')) {
                    // If time stamp expire then return null and clear local storage
                    if (new Date().getTime() < record.timestamp) {
                        return JSON.parse(record.value);
                    }
                    else {
                        localStorage.removeItem(key);
                        return null;
                    }
                } else {
                    return JSON.parse(record.value);
                }

            }
            catch (error) {
                return null;
            }
        }

        function DisablePage(btnObj) {
            if (typeof (Page_IsValid) != "undefined") {
                if (!Page_IsValid) {
                    return;
                }
            }
            var height = $(document).height() + 50;
            var width = $(document).width();
            $(btnObj).after("<div id='disablepage' style='height:" + height + "px;width:" + width + "px;'/>");
        }

    </script>
